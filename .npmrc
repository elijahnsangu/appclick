# Use hoisted (flat npm-style) node_modules instead of pnpm's default isolated linker.
# Reason: junction creation on Windows/WSL is dramatically slower than flat installs
# and has been the source of recurring install slowness + ChunkLoadError noise. Hoisted
# avoids junctions entirely. Trade-off: weaker dependency isolation across packages,
# but the monorepo doesn't rely on isolated boundaries for correctness.
node-linker=hoisted
