# Marliket Ops (review) app - environment template.
# Copy to .env.local for local dev. Deployed values are set per-tier in Vercel.
#
# Auth (same-origin issuance): in production BETTER_AUTH_URL is this app's own
# origin (https://ops.marliket.com). BETTER_AUTH_SECRET and DATABASE_URL MUST be
# identical to apps/app and the apps/server Worker within a tier, or the Worker
# silently rejects every session.

# Server
BETTER_AUTH_URL="http://localhost:3005"
BETTER_AUTH_SECRET=""
DATABASE_URL=""
RESEND_FROM=""

# Client
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WEB_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:8787"
