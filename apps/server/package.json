{
  "name": "server",
  "private": true,
  "type": "module",
  "exports": {
    "./rpc": {
      "types": "./dist-types/apps/server/src/rpc.d.ts"
    }
  },
  "scripts": {
    "build:types": "tsc -p tsconfig.types.json",
    "predev": "pnpm build:types",
    "postinstall": "pnpm build:types",
    "dev": "wrangler dev --test-scheduled --port 8787",
    "dev:preview": "wrangler dev --env preview --test-scheduled --port 8787",
    "deploy": "wrangler deploy --env=\"\"",
    "deploy:preview": "wrangler deploy --env preview",
    "deploy:production": "wrangler deploy --env production",
    "build": "wrangler deploy --dry-run --outdir dist --env=\"\"",
    "build:preview": "wrangler deploy --dry-run --outdir dist --env preview",
    "build:production": "wrangler deploy --dry-run --outdir dist --env production",
    "backfill:vehicle-discovery": "tsx scripts/backfill-vehicle-discovery.ts",
    "secret:preview": "wrangler secret put --env preview",
    "secret:production": "wrangler secret put --env production",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "cf-typegen": "wrangler types",
    "clean": "git clean -xdf .cache .turbo dist node_modules"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.5.1",
    "@neondatabase/serverless": "^1.1.0",
    "@repo/auth": "workspace:*",
    "@repo/business": "workspace:*",
    "@repo/database": "workspace:*",
    "@repo/discovery": "workspace:*",
    "@repo/listing": "workspace:*",
    "@repo/storage": "workspace:*",
    "@scalar/hono-api-reference": "^0.11.11",
    "better-auth": "^1.6.23",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.12.30",
    "stoker": "^2.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "tsx": "4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "4.112.0"
  }
}
