# Marliket marketing site - environment template.
# Copy to .env.local for local dev. Deployed values are set per-tier in Vercel.
# Vars mirror what apps/web/env.ts actually composes (cms, next-config, email,
# observability, feature-flags, security, rate-limit) - all optional here.

# Server
RESEND_FROM=""
RESEND_TOKEN=""
BASEHUB_TOKEN=""
BETTERSTACK_API_KEY=""
BETTERSTACK_URL=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
FLAGS_SECRET=""
ARCJET_KEY=""
UPSTASH_REDIS_REST_TOKEN=""
UPSTASH_REDIS_REST_URL=""
VERCEL_PROJECT_PRODUCTION_URL="http://localhost:3001"

# Client
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_PRO_URL="http://localhost:3004"
NEXT_PUBLIC_WEB_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:8787"
# apps/docs runs `mintlify dev --port 3004`, which collides with apps/pro's
# port - only run one of the two locally at a time.
NEXT_PUBLIC_DOCS_URL="http://localhost:3004"
