{
  "name": "marliket",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "turbo build",
    "dev": "turbo dev",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "test": "turbo test",
    "test:e2e": "node tests/e2e/run-all.ts",
    "test:e2e:business-authority": "playwright test --config playwright.business-authority.config.ts",
    "test:e2e:marketplace-roles": "playwright test --config playwright.marketplace-roles.config.ts",
    "test:e2e:representative-access": "playwright test --config playwright.representative-access.config.ts",
    "test:e2e:vehicle-listing": "playwright test --config playwright.vehicle-listing.config.ts",
    "test:e2e:vehicle-discovery": "playwright test --config playwright.vehicle-discovery.config.ts",
    "analyze": "turbo analyze",
    "translate": "turbo translate",
    "boundaries": "turbo boundaries",
    "bump-deps": "pnpm dlx npm-check-updates --deep -u && pnpm install",
    "bump-ui": "pnpm dlx shadcn@latest add --all --overwrite -c packages/design-system",
    "db:drizzle:generate": "pnpm --filter @repo/database run db:drizzle:generate",
    "db:drizzle:migrate": "pnpm --filter @repo/database run db:drizzle:migrate",
    "db:drizzle:pull": "pnpm --filter @repo/database run db:drizzle:pull",
    "db:drizzle:push": "pnpm --filter @repo/database run db:drizzle:push",
    "migrate": "pnpm db:drizzle:migrate",
    "migrate:deploy": "pnpm db:drizzle:migrate",
    "db:push": "pnpm db:drizzle:push",
    "clean": "git clean -xdf node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@neondatabase/serverless": "^1.1.0",
    "@playwright/test": "^1.62.0",
    "@repo/database": "workspace:*",
    "@repo/listing": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@turbo/gen": "^2.10.5",
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "drizzle-orm": "1.0.0-rc.4",
    "postgres": "^3.4.9",
    "turbo": "^2.10.5",
    "typescript": "^6.0.3",
    "ultracite": "7.9.4",
    "vitest": "^4.1.10",
    "ws": "^8.21.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.14.0",
  "type": "module"
}
