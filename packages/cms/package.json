{
  "name": "@repo/cms",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "basehub dev",
    "build": "if [ -n \"$BASEHUB_TOKEN\" ]; then basehub build; else echo 'Skipping basehub build: BASEHUB_TOKEN not set'; fi",
    "analyze": "basehub",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@t3-oss/env-nextjs": "^0.13.11",
    "basehub": "^9.6.0",
    "react": "19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "next": "16.2.10"
  }
}
